{
  "name": "qa-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "icons": "node scripts/build-icons.mjs",
    "prestart": "npm run icons",
    "start": "ng serve",
    "prebuild": "npm run icons",
    "build": "ng build",
    "build:pages": "npm run build -- --base-href /qa-portfolio/ && node scripts/spa-fallback.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run icons",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint && node scripts/build-icons.mjs --check",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
