{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs",
      "startServerReadyPattern": "serve-dist",
      "url": [
        "http://localhost:8080/qa-portfolio/",
        "http://localhost:8080/qa-portfolio/about",
        "http://localhost:8080/qa-portfolio/projects",
        "http://localhost:8080/qa-portfolio/projects/port",
        "http://localhost:8080/qa-portfolio/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3000, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
        "total-byte-weight": ["error", { "maxNumericValue": 512000, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
